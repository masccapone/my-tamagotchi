# 서버
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 공공데이터포털(data.go.kr) 발급 인증키
# https://www.data.go.kr 회원가입 후 아래 API들을 "활용신청"하면 마이페이지에서
# 서비스별 인증키(일반 인증키 Decoding 값)를 받을 수 있습니다.
# 승인까지 보통 1~2일(자동승인은 즉시) 소요됩니다.
DATA_GO_KR_SERVICE_KEY=

# 한국교통안전공단_자동차 종합정보 검사정보 서비스 (data.go.kr 15057736)
# 성능기록부의 "검사이력/판정" 부분에 대응
CAR365_INSPECTION_BASE_URL=https://apis.data.go.kr/1613000/InspectHistoryService
CAR365_INSPECTION_PATH=/getInspectHistoryList

# 한국교통안전공단_자동차 종합정보 정비이력정보 서비스 (data.go.kr 15057856)
# 성능기록부의 "정비/수리이력" 부분에 대응
CAR365_MAINTENANCE_BASE_URL=https://apis.data.go.kr/1613000/MaintenanceHistoryService
CAR365_MAINTENANCE_PATH=/getMaintenanceHistoryList

# 한국교통안전공단_자동차종합정보 신규등록정보 서비스 (data.go.kr 15059401)
CAR365_REGISTRATION_BASE_URL=https://apis.data.go.kr/1613000/NewRegistInfoService
CAR365_REGISTRATION_PATH=/getNewRegistInfoList

# 한국교통안전공단_자동차 종합정보 변경등록정보 서비스 (data.go.kr 15056611)
# 소유권 이전(명의변경) 횟수 -> 사고/침수 간접 위험 신호로 활용
CAR365_OWNERSHIP_CHANGE_BASE_URL=https://apis.data.go.kr/1613000/ChangeRegistInfoService
CAR365_OWNERSHIP_CHANGE_PATH=/getChangeRegistInfoList

# 국토교통부_자동차 리콜정보 API 서비스 (data.go.kr 15089863)
RECALL_BASE_URL=https://apis.data.go.kr/1613000/RecallInfoService
RECALL_PATH=/getRecallInfoList

# NOTE: 위 base URL / path / 응답 필드명은 공공데이터포털 활용가이드 문서 기준의
# "표준 규격"을 따른 추정값입니다. 실제 인증키 발급 후 포털의 "미리보기" 또는
# "활용가이드" 문서를 열어 정확한 URL과 응답 필드명을 확인해
# src/providers/car365/*.ts 의 매퍼(mapXxx 함수)를 맞춰주세요.
